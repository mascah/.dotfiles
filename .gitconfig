# Shared across machines. Email and machine-specific settings live in the
# untracked ~/.gitconfig.local (see .dotfiles_readme.md).
[user]
	name = Mike Ascah
	# Refuse to commit until ~/.gitconfig.local (or a repo) sets an email,
	# so no machine falls back to a guessed or wrong address.
	useConfigOnly = true
[include]
	path = ~/.gitconfig.local
